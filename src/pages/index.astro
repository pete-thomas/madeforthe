  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Peter Thomas, Design Leader</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22256%22 height=%22256%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2250%22 fill=%22%234138ff%22></rect><path fill=%22%23fff%22 d=%22%22></path></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400&display=swap" rel="stylesheet">
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            bg:    '#FFFFFF',
            ink:   '#1A1A1A',
            muted: '#93908B',
            rule:  '#DAD9D2',
            navy:  '#4137FF',
          },
          fontFamily: {
            sans: ['Geist', 'Helvetica Neue', 'Arial', 'sans-serif'],
            mono: ['Geist Mono', 'monospace'],
          },
        }
      }
    }
  </script>
  <script is:inline>
    // Apply dark class before first paint to avoid flash
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.documentElement.classList.add('dark');
    }
  </script>
  <style>
    .hero-title { font-size: clamp(2.8rem, 6vw, 5rem); letter-spacing: -0.03em; line-height: 1.08; }
    .cta-title  { font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -0.02em; }
    a { text-decoration: none; }
    .animate-ping { animation-duration: 2s; }
  </style>
</head>
