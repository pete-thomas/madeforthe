---
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Peter Thomas, Design Leader</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            bg:    '#FBFAF6',
            ink:   '#1A1A1A',
            muted: '#93908B',
            rule:  '#DAD9D2',
            navy:  '#4137FF',
          },
          fontFamily: {
            sans: ['Inter', 'Helvetica Neue', 'Arial', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
        }
      }
    }
  </script>
  <script is:inline>
    // Apply dark class before first paint to avoid flash
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.documentElement.classList.add('dark');
    }
  </script>
  <style>
    .hero-title { font-size: clamp(2.8rem, 6vw, 5rem); letter-spacing: -0.03em; line-height: 1.08; }
    .cta-title  { font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -0.02em; }
    a { text-decoration: none; }
    .animate-ping { animation-duration: 2s; }
  </style>
</head>
<body class="bg-[#FBFAF6] dark:bg-[#141413] text-[#1A1A1A] dark:text-[#D4D4D0] font-sans antialiased transition-colors duration-200">

  <!-- Nav -->
  <nav class="flex justify-between items-center py-7 px-12">
    <span class="text-sm font-medium flex items-center gap-2">
      <span class="relative flex items-center justify-center w-2 h-2 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-navy opacity-60"></span>
        <span class="relative inline-flex w-2 h-2 rounded-full bg-navy"></span>
      </span>
      Peter Thomas
    </span>
    <div class="flex items-center gap-8 text-sm text-[#93908B]">
      <a href="#about"      class="hover:text-navy transition-colors duration-150">About</a>
      <a href="#experience" class="hover:text-navy transition-colors duration-150">Experience</a>
      <a href="mailto:contact.petethomas@gmail.com" class="hover:text-navy transition-colors duration-150">Say hello</a>
      <!-- Theme toggle -->
      <button id="theme-toggle" aria-label="Toggle dark mode" class="w-7 h-7 flex items-center justify-center rounded hover:text-navy transition-colors duration-150">
        <!-- Sun (shown in dark mode) -->
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 hidden">
          <path d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 15ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM15.657 5.404a.75.75 0 1 0-1.06-1.06l-1.061 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM6.464 14.596a.75.75 0 1 0-1.06-1.06l-1.06 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 5 10ZM14.596 15.657a.75.75 0 0 0 1.06-1.06l-1.06-1.061a.75.75 0 1 0-1.06 1.06l1.06 1.06ZM5.404 6.464a.75.75 0 0 0 1.06-1.06L5.404 4.343a.75.75 0 1 0-1.06 1.06l1.06 1.061Z" />
        </svg>
        <!-- Moon (shown in light mode) -->
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path fill-rule="evenodd" d="M7.455 2.004a.75.75 0 0 1 .26.77 7 7 0 0 0 9.958 7.967.75.75 0 0 1 1.067.853A8.5 8.5 0 1 1 6.647 1.921a.75.75 0 0 1 .808.083Z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Hero -->
  <div class="pt-20 pb-24 px-12 max-w-5xl">
    <p class="text-xs font-normal font-mono tracking-widest uppercase text-[#93908B] mb-7">Design leader · London</p>
    <h1 class="hero-title font-semibold mb-9">
      Building teams that do<br>their <span class="text-navy">best work.</span>
    </h1>
    <p class="text-lg leading-relaxed text-[#93908B] max-w-xl">
      Director of Product Design at <a href="https://www.cloudflare.com/" target="_blank" class="text-[#c44800] hover:opacity-80 transition-opacity duration-150">Cloudflare</a>. 15+ years designing complex technical products and the organisations that build them. Currently moving designers from AI-curious to AI-native.
    </p>
  </div>

  <hr class="border-0 h-px bg-[#DAD9D2] dark:bg-[#2A2A28] mx-12">

  <!-- About -->
  <section id="about" class="py-20 px-12">
    <span class="block text-xs font-normal font-mono tracking-widest uppercase text-[#93908B] mb-10">About</span>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 max-w-5xl">

      <div class="space-y-5 text-base leading-loose">
        <p>I've spent 8 years at <a href="https://www.cloudflare.com" target="_blank" class="text-[#c44800] hover:opacity-80 transition-opacity duration-150">Cloudflare</a> growing from Lead Designer to Director, long enough to have built products, built teams, and figured out what actually makes design organisations work. Currently directing design across Security and Performance products, most recently moving designer from AI-curious to AI-native, helping build the processes and culture to get the whole team shipping with AI-assisted workflows.</p>
        <p>Before Cloudflare I spent nearly 5 years at <a href="https://www.geckoboard.com/" target="_blank" class="text-[#1a7a2e] hover:opacity-80 transition-opacity duration-150">Geckoboard</a>, joining as the sole designer and building the design function at a SaaS dashboarding tool used by thousands of businesses. Prior to that, product design at <a href="https://www.huddle.com" target="_blank" class="text-[#0089D0] hover:opacity-80 transition-opacity duration-150">Huddle</a> an enterprise document collaboration platform where I developed a strong foundation in end-to-end product design.</p>
        <p>I'm passionate about building high-performing design teams and creating the conditions for designers to do their best work.</p>
      </div>

      <div class="pt-1 space-y-10">
        <div>
          <span class="block text-xs font-normal font-mono tracking-widest uppercase text-[#93908B] mb-3.5">Currently thinking about</span>
          <ul class="space-y-1 text-sm leading-loose list-none">
            <li>AI-native design workflows</li>
            <li>Building curious, high-trust teams</li>
            <li>Design in complex technical products</li>
            <li>How AI changes the shape of design</li>
          </ul>
        </div>
        <div>
          <span class="block text-xs font-normal font-mono tracking-widest uppercase text-[#93908B] mb-3.5">Principles</span>
          <p class="text-sm leading-relaxed mb-2.5">Great design comes from curious people working on genuinely hard problems together.</p>
          <p class="text-sm leading-relaxed">Design teams earn trust through delivery, and that trust, over time, opens the doors that matter.</p>
        </div>
      </div>

    </div>
  </section>

  <hr class="border-0 h-px bg-[#DAD9D2] dark:bg-[#2A2A28] mx-12">

  <!-- Experience -->
  <section id="experience" class="py-20 px-12">
    <span class="block text-xs font-normal font-mono tracking-widest uppercase text-[#93908B] mb-10">Experience</span>
    <div class="max-w-5xl divide-y divide-[#DAD9D2] dark:divide-[#2A2A28]">

      <div class="py-8 flex gap-8 group">
        <div class="w-8 h-8 rounded-full overflow-hidden bg-white dark:bg-[#2A2A28] border border-[#DAD9D2] dark:border-[#3A3A38] shrink-0 flex items-center justify-center mt-0.5">
          <img src="https://www.google.com/s2/favicons?domain=cloudflare.com&sz=64" alt="Cloudflare" class="w-4 h-4 object-contain">
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline justify-between gap-4 mb-1">
            <div class="text-base font-semibold leading-snug">Director of Product Design</div>
            <div class="text-xs text-[#93908B] shrink-0 font-mono">2025 – Present</div>
          </div>
          <a href="https://www.cloudflare.com" target="_blank" class="text-xs font-semibold tracking-widest uppercase text-[#c44800] hover:opacity-80 transition-opacity duration-150 mb-3 block">Cloudflare</a>
          <p class="text-sm text-[#93908B] leading-relaxed">Leading design across Security and Performance, Cloudflare's highest-revenue portfolio. A global team of 11, VP-level partnerships, and an organisation-wide shift to AI-native design practice.</p>
        </div>
      </div>

      <div class="py-8 flex gap-8 group">
        <div class="w-8 h-8 rounded-full overflow-hidden bg-white dark:bg-[#2A2A28] border border-[#DAD9D2] dark:border-[#3A3A38] shrink-0 flex items-center justify-center mt-0.5">
          <img src="https://www.google.com/s2/favicons?domain=cloudflare.com&sz=64" alt="Cloudflare" class="w-4 h-4 object-contain">
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline justify-between gap-4 mb-1">
            <div class="text-base font-semibold leading-snug">Design Lead → Senior Design Manager</div>
            <div class="text-xs text-[#93908B] shrink-0 font-mono">2019 – 2025</div>
          </div>
          <a href="https://www.cloudflare.com" target="_blank" class="text-xs font-semibold tracking-widest uppercase text-[#c44800] hover:opacity-80 transition-opacity duration-150 mb-3 block">Cloudflare</a>
          <p class="text-sm text-[#93908B] leading-relaxed">Built and scaled the London design team from the ground up. Led design across Security, Performance, and Analytics. Shipped the WAF redesign, Firewall Events, and Analytics platforms from 0–1.</p>
        </div>
      </div>

      <div class="py-8 flex gap-8 group">
        <div class="w-8 h-8 rounded-full overflow-hidden bg-white dark:bg-[#2A2A28] border border-[#DAD9D2] dark:border-[#3A3A38] shrink-0 flex items-center justify-center mt-0.5">
          <img src="https://www.google.com/s2/favicons?domain=geckoboard.com&sz=64" alt="Geckoboard" class="w-full h-full object-contain">
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline justify-between gap-4 mb-1">
            <div class="text-base font-semibold leading-snug">Product Design Lead</div>
            <div class="text-xs text-[#93908B] shrink-0 font-mono">2013 – 2018</div>
          </div>
          <a href="https://www.geckoboard.com" target="_blank" class="text-xs font-semibold tracking-widest uppercase text-[#1a7a2e] hover:opacity-80 transition-opacity duration-150 mb-3 block">Geckoboard</a>
          <p class="text-sm text-[#93908B] leading-relaxed">Joined as the sole designer and shaped the design function over 4.5 years at a SaaS dashboarding tool used by thousands of businesses. Owned end-to-end product design across web and mobile.</p>
        </div>
      </div>

      <div class="py-8 flex gap-8 group">
        <div class="w-8 h-8 rounded-full overflow-hidden bg-white dark:bg-[#2A2A28] border border-[#DAD9D2] dark:border-[#3A3A38] shrink-0 flex items-center justify-center mt-0.5">
          <img src="https://www.google.com/s2/favicons?domain=huddle.com&sz=64" alt="Huddle" class="w-full h-full object-contain">
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline justify-between gap-4 mb-1">
            <div class="text-base font-semibold leading-snug">Product Designer</div>
            <div class="text-xs text-[#93908B] shrink-0 font-mono">2012 – 2013</div>
          </div>
          <a href="https://www.huddle.com" target="_blank" class="text-xs font-semibold tracking-widest uppercase text-[#0089D0] hover:opacity-80 transition-opacity duration-150 mb-3 block">Huddle</a>
          <p class="text-sm text-[#93908B] leading-relaxed">Designed core functionality and new features for an enterprise document collaboration platform across web and mobile, partnering with research and engineering from concept through delivery.</p>
        </div>
      </div>

      <div class="pt-4">
        <a href="https://www.linkedin.com/in/peter--thomas" target="_blank" class="text-sm text-[#93908B] hover:text-navy transition-colors duration-150">Full profile on LinkedIn →</a>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-[#DAD9D2] dark:border-[#2A2A28] py-7 px-12 flex justify-between items-center">
    <span class="text-xs text-[#93908B]">© Peter Thomas 2026</span>
    <div class="flex gap-6 text-xs text-[#93908B]">
      <a href="https://www.linkedin.com/in/peter--thomas" target="_blank" class="hover:text-navy transition-colors duration-150">LinkedIn</a>
      <a href="mailto:contact.petethomas@gmail.com" class="hover:text-navy transition-colors duration-150">contact.petethomas@gmail.com</a>
    </div>
  </footer>

  <script is:inline>
    const toggle = document.getElementById('theme-toggle');
    const sun    = document.getElementById('icon-sun');
    const moon   = document.getElementById('icon-moon');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      sun.classList.toggle('hidden', !isDark);
      moon.classList.toggle('hidden', isDark);
    }

    updateIcons();

    toggle.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      updateIcons();
    });
  </script>

</body>
</html>
